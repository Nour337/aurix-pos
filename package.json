    "@fontsource/inter": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@tanstack/react-query": "^5.104.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^1.59.0",
    "postcss": "^8.5.31",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^3.4.17",
    "terser": "^5.51.2",
    "tsx": "^4.23.15",
