{
  "name": "aurix-pos",
  "version": "1.0.0",
  "description": "AURIX — bilingual POS & inventory. Frontend on GitHub Pages, Google Sheets + Apps Script as the backend.",
  "scripts": {
    "dev": "concurrently -k -n bridge,web \"tsx watch tests/dev-server.ts\" \"vite\"",
    "build": "vite build && node scripts/build-gas.mjs",
